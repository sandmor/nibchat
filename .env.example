# Copy to .env and fill secrets:
#   cp .env.example .env
#   openssl rand -base64 32   # paste into BETTER_AUTH_SECRET
#
# Used by local `pnpm --filter web dev`, Docker Compose, and scripts.

# Required in production.
BETTER_AUTH_SECRET=

# Public origin of this instance (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# SQLite when DATABASE_URL is unset. Paths are relative to the monorepo root.
SQLITE_PATH=./data/vero.db

# When set, Vero uses Postgres instead of SQLite.
# Local: DATABASE_URL=postgres://vero:vero@localhost:5432/vero
# Docker (--profile postgres): DATABASE_URL=postgres://vero:vero@postgres:5432/vero
# DATABASE_URL=
# DATABASE_POOL_SIZE=8
