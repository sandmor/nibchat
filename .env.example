# Copy to .env and fill secrets:
#   cp .env.example .env
#   openssl rand -base64 32   # paste into BETTER_AUTH_SECRET
#
# Used by local `pnpm --filter web dev`, Docker Compose, and scripts.

# Required in production.
BETTER_AUTH_SECRET=

# Public origin of this instance (no trailing slash).
BETTER_AUTH_URL=http://localhost:3000

# SQLite when DATABASE_URL is unset. Paths are relative to the monorepo root.
SQLITE_PATH=./data/nibchat.db

# When set, Nibchat uses Postgres instead of SQLite.
# Local: DATABASE_URL=postgres://nibchat:nibchat@localhost:5432/nibchat
# Docker (--profile postgres): DATABASE_URL=postgres://nibchat:nibchat@postgres:5432/nibchat
# DATABASE_URL=
# DATABASE_POOL_SIZE=8

# MCP client lifecycle. `stateful` shares one persistent client per profile in
# this process. Serverless/ephemeral deployments must use `stateless`, which
# permits only externally hosted modern Streamable HTTP MCP servers.
# Header/env values may use ${ENV_NAME} templates (resolved at connect time).
MCP_RUNTIME_MODE=stateful

# Generation stream lifecycle. Stateful + memory is the local/Docker default.
# Stateless mode requires `GENERATION_STREAM_BACKEND=redis` and REDIS_URL.
# REDIS_URL may be redis:// (TCP) or https:// (HTTP command POST).
# GENERATION_RUNTIME_MODE=stateful
# GENERATION_STREAM_BACKEND=memory
# REDIS_URL=redis://localhost:6379
# REDIS_TOKEN=

# Optional. Select this name on an Ollama Cloud provider in Settings.
# OLLAMA_API_KEY=

# Image attachment storage. Filesystem is the default for the stateful Docker
# install; use database storage for serverless or deployments without a shared volume.
# ATTACHMENT_STORAGE=filesystem
# ATTACHMENT_FILESYSTEM_PATH=./data/attachments
